---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const navItems = [
  { href: '/admin', label: 'Vue d\'ensemble' },
  { href: '/admin/projects', label: 'Projets' },
  { href: '/admin/profile', label: 'Profil' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin</title>
  </head>
  <body class="min-h-screen bg-bg text-slate-200">
    <div class="flex min-h-screen">
      <aside class="w-56 shrink-0 border-r border-white/10 bg-surface px-4 py-6">
        <a href="/" class="block font-mono text-sm text-white">
          matane<span class="text-accent">@</span>admin
        </a>
        <nav class="mt-8 flex flex-col gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
            >
              {item.label}
            </a>
          ))}
        </nav>
        <form method="POST" action="/admin/logout" class="mt-8">
          <button type="submit" class="text-sm text-slate-500 hover:text-red-400">
            Déconnexion
          </button>
        </form>
      </aside>
      <main class="flex-1 px-8 py-8">
        <h1 class="text-2xl font-bold text-white">{title}</h1>
        <div class="mt-6">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
