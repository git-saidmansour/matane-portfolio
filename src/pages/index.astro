---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Formation from '../components/Formation.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import SecurityPractice from '../components/SecurityPractice.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getProfile, getProjects, getCvs } from '../lib/db';

const profile = getProfile();
const projects = getProjects();
const cvs = getCvs();
---

<Layout>
  <Header />
  <main>
    <Hero photoPath={profile.photo_path} cvs={cvs} />
    <About
      bio1={profile.bio_1}
      bio2={profile.bio_2}
      location={profile.location}
      formation={profile.formation}
      availability={profile.availability}
      languages={profile.languages}
    />
    <Experience />
    <Formation />
    <Projects projects={projects} />
    <Certifications />
    <Skills />
    <SecurityPractice />
    <Contact cvs={cvs} />
  </main>
  <Footer />
</Layout>
