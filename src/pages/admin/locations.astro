---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getLocationStats } from '../../lib/db';
import { feature } from 'topojson-client';
import worldTopologyJson from 'world-atlas/countries-110m.json';

const worldTopology: any = worldTopologyJson;

const { byCountry, points } = getLocationStats();

const visitsSorted = [...byCountry].sort((a, b) => b.visits - a.visits).filter((c) => c.visits > 0);
const downloadsSorted = [...byCountry].sort((a, b) => b.downloads - a.downloads).filter((c) => c.downloads > 0);
const clicksSorted = [...byCountry].sort((a, b) => b.clicks - a.clicks).filter((c) => c.clicks > 0);
const maxVisits = Math.max(1, ...visitsSorted.map((c) => c.visits));
const maxDownloads = Math.max(1, ...downloadsSorted.map((c) => c.downloads));
const maxClicks = Math.max(1, ...clicksSorted.map((c) => c.clicks));

function flagEmoji(code: string | null): string {
  if (!code || code.length !== 2) return '🏳️';
  return String.fromCodePoint(...[...code.toUpperCase()].map((c) => 127397 + c.charCodeAt(0)));
}

// Simple equirectangular projection onto a fixed viewBox.
const MAP_W = 800;
const MAP_H = 400;
const maxPointCount = Math.max(1, ...points.map((p) => p.n));

function project(lat: number, lon: number) {
  const x = ((lon + 180) / 360) * MAP_W;
  const y = ((90 - lat) / 180) * MAP_H;
  return { x, y };
}

// Country/continent outlines — Natural Earth data (public domain) via the
// world-atlas package, at its lowest ("110m") resolution: just enough detail
// to recognize countries and continents, not a precise coastline trace.
const worldGeo = feature(worldTopology, worldTopology.objects.countries) as unknown as {
  features: { properties: { name: string }; geometry: { type: string; coordinates: any } }[];
};

function ringToPath(ring: [number, number][]): string {
  return (
    ring
      .map(([lon, lat], i) => {
        const { x, y } = project(lat, lon);
        return `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
      })
      .join(' ') + ' Z'
  );
}

function geometryToPath(geometry: { type: string; coordinates: any }): string {
  if (geometry.type === 'Polygon') {
    return geometry.coordinates.map(ringToPath).join(' ');
  }
  if (geometry.type === 'MultiPolygon') {
    return geometry.coordinates
      .map((polygon: [number, number][][]) => polygon.map(ringToPath).join(' '))
      .join(' ');
  }
  return '';
}

const countryPaths = worldGeo.features.map((f) => ({
  name: f.properties.name,
  d: geometryToPath(f.geometry),
}));

---

<AdminLayout title="Localisations">
  <div class="card">
    <h2 class="font-mono text-xs uppercase tracking-wide text-slate-400">
      Position des visiteurs
    </h2>
    <p class="mt-1 text-xs text-slate-500">
      Un point par ville, taille proportionnelle au nombre d'événements.
    </p>
    <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} class="mt-4 w-full rounded-md border border-white/10 bg-bg">
      {countryPaths.map((c) => (
        <path d={c.d} fill="rgba(148,163,184,0.16)" stroke="rgba(148,163,184,0.35)" stroke-width="0.5" />
      ))}
      {points.map((p) => {
        const { x, y } = project(p.lat, p.lon);
        const r = 3 + Math.sqrt(p.n / maxPointCount) * 12;
        return (
          <circle cx={x} cy={y} r={r} fill="#22d3ee" fill-opacity="0.55" stroke="#22d3ee" stroke-width="1">
            <title>{[p.city, p.country].filter(Boolean).join(', ')} — {p.n} événement{p.n > 1 ? 's' : ''}</title>
          </circle>
        );
      })}
      {points.length === 0 && (
        <text x={MAP_W / 2} y={MAP_H / 2} text-anchor="middle" fill="rgba(148,163,184,0.6)" font-size="14">
          Pas encore de données de localisation
        </text>
      )}
    </svg>
  </div>

  <p class="mt-6 text-xs text-slate-500">Clique sur un pays pour voir le détail des visiteurs.</p>

  <div class="mt-2 grid grid-cols-1 gap-6 sm:grid-cols-3">
    <div class="card">
      <h2 class="font-mono text-xs uppercase tracking-wide text-accent">Visites par pays</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {visitsSorted.length === 0 && <li class="text-sm text-slate-500">Aucune donnée pour l'instant.</li>}
        {visitsSorted.map((c) => (
          <li>
            <button
              type="button"
              class="country-row w-full text-left"
              data-code={c.country_code}
              data-name={`${flagEmoji(c.country_code)} ${c.country}`}
            >
              <div class="flex items-center justify-between text-sm text-slate-300 hover:text-white">
                <span>{flagEmoji(c.country_code)} {c.country}</span>
                <span class="font-mono text-white">{c.visits}</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/5">
                <div class="h-full rounded-full bg-accent" style={`width: ${(c.visits / maxVisits) * 100}%`} />
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="card">
      <h2 class="font-mono text-xs uppercase tracking-wide text-accent2">Téléchargements CV par pays</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {downloadsSorted.length === 0 && <li class="text-sm text-slate-500">Aucune donnée pour l'instant.</li>}
        {downloadsSorted.map((c) => (
          <li>
            <button
              type="button"
              class="country-row w-full text-left"
              data-code={c.country_code}
              data-name={`${flagEmoji(c.country_code)} ${c.country}`}
            >
              <div class="flex items-center justify-between text-sm text-slate-300 hover:text-white">
                <span>{flagEmoji(c.country_code)} {c.country}</span>
                <span class="font-mono text-white">{c.downloads}</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/5">
                <div class="h-full rounded-full bg-accent2" style={`width: ${(c.downloads / maxDownloads) * 100}%`} />
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="card">
      <h2 class="font-mono text-xs uppercase tracking-wide text-slate-400">Clics sur les liens par pays</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {clicksSorted.length === 0 && <li class="text-sm text-slate-500">Aucune donnée pour l'instant.</li>}
        {clicksSorted.map((c) => (
          <li>
            <button
              type="button"
              class="country-row w-full text-left"
              data-code={c.country_code}
              data-name={`${flagEmoji(c.country_code)} ${c.country}`}
            >
              <div class="flex items-center justify-between text-sm text-slate-300 hover:text-white">
                <span>{flagEmoji(c.country_code)} {c.country}</span>
                <span class="font-mono text-white">{c.clicks}</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/5">
                <div class="h-full rounded-full bg-slate-400" style={`width: ${(c.clicks / maxClicks) * 100}%`} />
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div id="country-detail" class="card mt-6 hidden">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-white" id="country-detail-title"></h2>
      <button type="button" id="country-detail-close" class="text-sm text-slate-500 hover:text-white">Fermer ✕</button>
    </div>
    <div id="country-detail-body" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>
</AdminLayout>

<script>
  const relativeTimeFmt = new Intl.RelativeTimeFormat('fr-FR', { numeric: 'auto' });

  function relativeTime(isoStr: string) {
    const then = new Date(isoStr.replace(' ', 'T') + 'Z').getTime();
    const diffMin = Math.round((then - Date.now()) / 60000);
    if (Math.abs(diffMin) < 60) return relativeTimeFmt.format(diffMin, 'minute');
    const diffHour = Math.round(diffMin / 60);
    if (Math.abs(diffHour) < 24) return relativeTimeFmt.format(diffHour, 'hour');
    return relativeTimeFmt.format(Math.round(diffHour / 24), 'day');
  }

  const panel = document.getElementById('country-detail')!;
  const title = document.getElementById('country-detail-title')!;
  const body = document.getElementById('country-detail-body')!;
  const closeBtn = document.getElementById('country-detail-close')!;

  document.querySelectorAll<HTMLButtonElement>('.country-row').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code;
      const name = btn.dataset.name ?? '';
      if (!code) return;

      title.textContent = name;
      body.innerHTML = '<p class="text-sm text-slate-500">Chargement…</p>';
      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      try {
        const res = await fetch(`/admin/api/country-visitors.json?code=${encodeURIComponent(code)}`);
        const visitors = await res.json();

        if (!Array.isArray(visitors) || visitors.length === 0) {
          body.innerHTML = '<p class="text-sm text-slate-500">Aucun visiteur pour l\'instant.</p>';
          return;
        }

        const list = (items: string[], empty: string) => (items.length ? items.join(', ') : empty);
        body.innerHTML = visitors
          .map(
            (v: any) => `
          <div class="rounded-md border border-white/10 bg-bg p-4 text-sm">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-white">${v.city ?? 'Ville inconnue'}</span>
              <span class="text-xs text-slate-500">${relativeTime(v.lastSeen)}</span>
            </div>
            <dl class="mt-3 space-y-1.5 text-xs text-slate-400">
              <div><dt class="inline text-slate-500">Projets consultés :</dt> <dd class="inline">${list(v.projects, 'aucun')}</dd></div>
              <div><dt class="inline text-slate-500">Liens cliqués :</dt> <dd class="inline">${list(v.links, 'aucun')}</dd></div>
              <div><dt class="inline text-slate-500">CV téléchargé :</dt> <dd class="inline">${list(v.cvs, 'aucun')}</dd></div>
              <div><dt class="inline text-slate-500">Visites (tout temps) :</dt> <dd class="inline">${v.totalVisits}</dd></div>
            </dl>
          </div>`
          )
          .join('');
      } catch {
        body.innerHTML = '<p class="text-sm text-red-400">Erreur de chargement.</p>';
      }
    });
  });

  closeBtn.addEventListener('click', () => panel.classList.add('hidden'));
</script>
