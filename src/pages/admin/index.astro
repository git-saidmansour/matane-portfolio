---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getStats, getCvs } from '../../lib/db';

const stats = getStats();
const vapidPublicKey = process.env.VAPID_PUBLIC_KEY || '';
const cvLabels: Record<string, string> = Object.fromEntries(getCvs().map((cv) => [cv.slug, cv.label]));
const todayIso = new Date().toISOString().slice(0, 10);
---

<AdminLayout title="Vue d'ensemble">
  <div class="flex flex-wrap items-center gap-3">
    <div class="inline-flex rounded-md border border-white/10 bg-surface p-1">
      <button type="button" data-period-type="day" class="period-type-btn rounded px-3 py-1.5 text-sm">Jour</button>
      <button type="button" data-period-type="week" class="period-type-btn rounded px-3 py-1.5 text-sm">Semaine</button>
      <button type="button" data-period-type="month" class="period-type-btn rounded px-3 py-1.5 text-sm">Mois</button>
    </div>
    <input
      type="date"
      id="period-date"
      value={todayIso}
      max={todayIso}
      class="rounded-md border border-white/10 bg-surface px-3 py-2 text-sm text-white outline-none focus:border-accent"
    />
    <span id="period-label" class="text-sm text-slate-400"></span>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="card">
      <p class="font-mono text-xs uppercase tracking-wide text-accent">Visites</p>
      <div class="mt-2 flex items-baseline gap-3">
        <p class="text-3xl font-bold text-white" id="pv-current">{stats.period.current.pageViews}</p>
        <span id="pv-trend" class="font-mono text-sm text-slate-400"></span>
      </div>
      <p class="mt-2 text-xs text-slate-500">Total (tout temps) : <span id="pv-total">{stats.pageViews}</span></p>
    </div>

    <div class="card">
      <p class="font-mono text-xs uppercase tracking-wide text-accent2">Téléchargements CV</p>
      <div class="mt-2 flex items-baseline gap-3">
        <p class="text-3xl font-bold text-white" id="cv-current">{stats.period.current.cvDownloads}</p>
        <span id="cv-trend" class="font-mono text-sm text-slate-400"></span>
      </div>
      <p class="mt-2 text-xs text-slate-500">Total (tout temps) : <span id="cv-total">{stats.totalCvDownloads}</span></p>
    </div>
  </div>

  <div class="card mt-4">
    <p class="font-mono text-xs uppercase tracking-wide text-slate-400">Projets</p>
    <p class="mt-2 text-3xl font-bold text-white" id="project-count">{stats.projectCount}</p>
  </div>

  <div class="card mt-6">
    <h2 class="font-mono text-sm uppercase tracking-wide text-slate-400">
      Téléchargements par CV (tout temps)
    </h2>
    <ul class="mt-4 space-y-2 text-sm" id="cv-breakdown"></ul>
  </div>

  <div class="card mt-6">
    <h2 class="font-mono text-sm uppercase tracking-wide text-slate-400">Notifications</h2>
    <p class="mt-2 text-sm text-slate-400">
      Reçois une notification push dès qu'un CV est téléchargé, même dashboard fermé.
    </p>
    <button id="enable-push" class="btn-primary mt-4 text-sm">Activer les notifications</button>
    <p id="push-status" class="mt-2 text-sm text-slate-500"></p>
  </div>
</AdminLayout>

<style>
  .period-type-btn {
    color: rgb(148 163 184);
  }
  .period-type-btn.active {
    background-color: rgb(34 211 238 / 0.15);
    color: rgb(34 211 238);
  }
</style>

<script define:vars={{ vapidPublicKey, cvLabels, todayIso }}>
  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = atob(base64);
    return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
  }

  let periodType = 'day';
  let periodDate = todayIso;

  const dayFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const monthFmt = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const shortFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' });

  function formatPeriodLabel(type, dateStr) {
    const d = new Date(`${dateStr}T00:00:00Z`);
    if (type === 'day') return dateStr === todayIso ? "Aujourd'hui" : dayFmt.format(d);
    if (type === 'month') return monthFmt.format(d);
    const day = d.getUTCDay();
    const diffToMonday = day === 0 ? -6 : 1 - day;
    const monday = new Date(d.getTime() + diffToMonday * 86400000);
    const sunday = new Date(monday.getTime() + 6 * 86400000);
    return `Semaine du ${shortFmt.format(monday)} au ${dayFmt.format(sunday)}`;
  }

  function trendBadge(current, previous) {
    if (current === previous) return { text: '= stable', cls: 'text-slate-400' };
    if (previous === 0) return { text: `▲ +${current}`, cls: 'text-emerald-400' };
    const pct = Math.round(((current - previous) / previous) * 100);
    return pct > 0 ? { text: `▲ +${pct}%`, cls: 'text-emerald-400' } : { text: `▼ ${pct}%`, cls: 'text-red-400' };
  }

  function applyTrend(elId, current, previous) {
    const el = document.getElementById(elId);
    const trend = trendBadge(current, previous);
    el.textContent = trend.text;
    el.className = `font-mono text-sm ${trend.cls}`;
  }

  function renderCvBreakdown(rows) {
    const list = document.getElementById('cv-breakdown');
    if (rows.length === 0) {
      list.innerHTML = '<li class="text-slate-500">Aucun téléchargement pour l\'instant.</li>';
      return;
    }
    list.innerHTML = rows
      .map(
        (row) => `
      <li class="flex items-center justify-between text-slate-300">
        <span>${cvLabels[row.meta] ?? row.meta}</span>
        <span class="font-mono text-white">${row.n}</span>
      </li>`
      )
      .join('');
  }

  async function refreshStats() {
    try {
      const res = await fetch(`/admin/api/stats.json?period=${periodType}&date=${periodDate}`, { cache: 'no-store' });
      const stats = await res.json();

      document.getElementById('period-label').textContent = formatPeriodLabel(stats.period.type, stats.period.date);
      document.getElementById('pv-current').textContent = stats.period.current.pageViews;
      document.getElementById('cv-current').textContent = stats.period.current.cvDownloads;
      applyTrend('pv-trend', stats.period.current.pageViews, stats.period.previous.pageViews);
      applyTrend('cv-trend', stats.period.current.cvDownloads, stats.period.previous.cvDownloads);
      document.getElementById('pv-total').textContent = stats.pageViews;
      document.getElementById('cv-total').textContent = stats.totalCvDownloads;
      document.getElementById('project-count').textContent = stats.projectCount;
      renderCvBreakdown(stats.cvDownloadsByType);
    } catch {
      // silent — will retry on next SSE event
    }
  }

  document.querySelectorAll('.period-type-btn').forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.periodType === periodType);
    btn.addEventListener('click', () => {
      periodType = btn.dataset.periodType;
      document.querySelectorAll('.period-type-btn').forEach((b) => b.classList.toggle('active', b === btn));
      refreshStats();
    });
  });

  document.getElementById('period-date').addEventListener('change', (e) => {
    periodDate = e.target.value || todayIso;
    refreshStats();
  });

  refreshStats();

  function connectStream() {
    const source = new EventSource('/admin/api/events-stream');
    source.onmessage = () => refreshStats();
    source.onerror = () => {
      source.close();
      setTimeout(connectStream, 5000);
    };
  }
  connectStream();

  const pushStatus = document.getElementById('push-status');
  const enableBtn = document.getElementById('enable-push');

  async function updatePushUI() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      pushStatus.textContent = 'Non supporté par ce navigateur.';
      enableBtn.disabled = true;
      return;
    }
    if (!vapidPublicKey) {
      pushStatus.textContent = 'Clés VAPID non configurées sur le serveur.';
      enableBtn.disabled = true;
      return;
    }
    const reg = await navigator.serviceWorker.getRegistration();
    const sub = reg ? await reg.pushManager.getSubscription() : null;
    if (sub) {
      pushStatus.textContent = 'Notifications activées sur cet appareil.';
      enableBtn.textContent = 'Désactiver les notifications';
    } else {
      pushStatus.textContent = '';
      enableBtn.textContent = 'Activer les notifications';
    }
  }

  enableBtn?.addEventListener('click', async () => {
    const reg = await navigator.serviceWorker.register('/sw.js');
    const existing = await reg.pushManager.getSubscription();

    if (existing) {
      await fetch('/admin/api/push-subscribe', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: existing.endpoint }),
      });
      await existing.unsubscribe();
      await updatePushUI();
      return;
    }

    const permission = await Notification.requestPermission();
    if (permission !== 'granted') {
      pushStatus.textContent = 'Permission refusée.';
      return;
    }

    const sub = await reg.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
    });

    await fetch('/admin/api/push-subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(sub.toJSON()),
    });

    await updatePushUI();
  });

  updatePushUI();
</script>
