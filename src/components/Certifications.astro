---
interface CertEntry {
  name: string;
  issuer: string;
  status: 'obtained' | 'in_progress';
}

const certifications: CertEntry[] = [
  { name: 'eJPT — eLearnSecurity Junior Penetration Tester', issuer: 'INE Security', status: 'in_progress' },
  { name: 'Burp Suite Certified Practitioner', issuer: 'PortSwigger', status: 'in_progress' },
];
---

<section id="certifications" class="section scroll-mt-24">
  <div class="section-head">
    <p class="section-title-pill">Certifications</p>
    <h2 class="heading">Formations complémentaires</h2>
  </div>

  <div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
    {certifications.map((cert) => (
      <div
        class={`card flex items-center gap-3 ${
          cert.status === 'in_progress' ? 'border-amber-400/25 bg-amber-400/5' : ''
        }`}
      >
        {cert.status === 'obtained' ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0 text-emerald-400" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M8.5 12.5l2.5 2.5 5-5" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0 text-amber-400" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3.5 2" />
          </svg>
        )}
        <div>
          <p class="font-semibold text-white">{cert.name}</p>
          <p class="mt-0.5 text-sm text-slate-500">
            {cert.issuer}
            {cert.status === 'in_progress' && <span class="text-amber-400"> · En préparation</span>}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
