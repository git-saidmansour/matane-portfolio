---
import Icon from './Icon.astro';
import type { icons } from '../lib/icons';

interface CertEntry {
  name: string;
  issuer: string;
  status: 'obtained' | 'in_progress';
  icon: keyof typeof icons | null;
}

const certifications: CertEntry[] = [
  { name: 'eJPT — eLearnSecurity Junior Penetration Tester', issuer: 'INE Security', status: 'in_progress', icon: null },
  { name: 'Burp Suite Certified Practitioner', issuer: 'PortSwigger', status: 'in_progress', icon: 'burpsuite' },
];
---

<section id="certifications" class="section scroll-mt-24">
  <div class="section-head">
    <p class="section-title-pill">Certifications</p>
    <h2 class="heading">Formations complémentaires</h2>
  </div>

  <div class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
    {certifications.map((cert) => (
      <div
        class={`card flex items-center gap-3 ${
          cert.status === 'in_progress' ? 'border-amber-400/25 bg-amber-400/5' : ''
        }`}
      >
        <span
          class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border ${
            cert.status === 'in_progress'
              ? 'border-amber-400/30 bg-amber-400/10 text-amber-400'
              : 'border-emerald-400/30 bg-emerald-400/10 text-emerald-400'
          }`}
        >
          {cert.icon ? (
            <Icon name={cert.icon} class="h-5 w-5" />
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
              <path d="M12 3l7 3.5v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5Z" />
              <path d="M9.5 12l1.8 1.8L14.8 10" />
            </svg>
          )}
        </span>
        <div>
          <p class="font-semibold text-white">{cert.name}</p>
          <p class="mt-0.5 text-sm text-slate-500">
            {cert.issuer}
            {cert.status === 'in_progress' && <span class="text-amber-400"> · En préparation</span>}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
