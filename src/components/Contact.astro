---
const email = 'mansour50said@gmail.com';
const socials = [
  { label: 'GitHub', href: 'https://github.com/git-saidmansour' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/in-saidmansour' },
];
const cvs = [
  { label: 'CV — Réseaux & Cybersécurité', href: '/cv/matane-mansour-cv-reseaux-cybersecurite.pdf' },
  { label: 'CV — Data & IA', href: '/cv/matane-mansour-cv-data-ia.pdf' },
];
---

<section id="contact" class="section scroll-mt-24">
  <p class="section-title">Contact</p>
  <h2 class="heading">Discutons</h2>
  <p class="mt-4 max-w-2xl text-slate-400">
    Ouvert à une alternance de 12 mois à partir de septembre 2026, ou à
    toute collaboration sur des projets. N'hésite pas à me contacter.
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a href={`mailto:${email}`} class="btn-primary">{email}</a>
    {socials.map((social) => (
      <a href={social.href} target="_blank" rel="noopener noreferrer" class="btn">
        {social.label}
      </a>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    {cvs.map((cv) => (
      <a href={cv.href} download class="font-mono text-sm text-accent hover:underline">
        &darr; {cv.label}
      </a>
    ))}
  </div>
</section>
