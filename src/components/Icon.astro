---
import { icons } from '../lib/icons';

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
const icon = icons[name];
---

<svg
  viewBox={icon.viewBox}
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <path d={icon.path} />
</svg>
