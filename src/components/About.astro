---
interface Props {
  bio1: string;
  bio2: string;
  location: string;
  formation: string;
  availability: string;
  languages: string;
}

const { bio1, bio2, location, formation, availability, languages } = Astro.props;
---

<section id="about" class="section scroll-mt-24">
  <p class="section-title">À propos</p>
  <h2 class="heading">Qui suis-je</h2>

  <div class="mt-8 grid gap-10 sm:grid-cols-3">
    <div class="sm:col-span-2">
      <p class="text-slate-400">{bio1}</p>
      <p class="mt-4 text-slate-400">{bio2}</p>
    </div>
    <div class="card">
      <h3 class="font-mono text-sm uppercase tracking-wide text-accent">
        Infos rapides
      </h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li><span class="text-slate-200">Basé à :</span> {location}</li>
        <li><span class="text-slate-200">Formation :</span> {formation}</li>
        <li><span class="text-slate-200">Dispo :</span> {availability}</li>
        <li><span class="text-slate-200">Langues :</span> {languages}</li>
      </ul>
    </div>
  </div>
</section>
