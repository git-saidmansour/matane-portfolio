---
import type { Cv } from '../lib/db';
import Icon from './Icon.astro';
import type { icons } from '../lib/icons';

interface Props {
  photoPath?: string;
  cvs?: Cv[];
}

const { photoPath = '/images/portrait.webp', cvs = [] } = Astro.props;

const tools: { icon: keyof typeof icons | null; name: string }[] = [
  { icon: 'linux', name: 'Linux' },
  { icon: 'docker', name: 'Docker' },
  { icon: 'git', name: 'Git' },
  { icon: 'python', name: 'Python' },
  { icon: null, name: 'Exegol' },
  { icon: 'burpsuite', name: 'Burp Suite' },
];
---

<section class="relative flex min-h-screen items-center overflow-hidden px-4 pb-10 pt-28 sm:px-8">
  {/* Blobs décoratifs */}
  <div
    class="pointer-events-none absolute left-[5%] top-[10%] -z-10 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.14)_0%,transparent_70%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute right-[8%] top-[22%] -z-10 h-[480px] w-[480px] rounded-full bg-[radial-gradient(circle,rgba(167,139,250,0.14)_0%,transparent_70%)]"
  >
  </div>

  <div class="mx-auto w-full max-w-5xl">
    <div class="rounded-3xl border border-white/10 bg-surface/80 p-6 shadow-[0_40px_100px_-30px_rgba(0,0,0,0.6)] sm:p-10">
      {/* En-tête de la carte : badge de disponibilité seul (le logo est déjà dans la nav fixe) */}
      <div class="flex justify-center sm:justify-end">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 font-mono text-xs text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          Disponible en alternance — septembre 2026
        </div>
      </div>

      {/* Texte + photo côte à côte */}
      <div class="mt-10 flex flex-col-reverse items-center gap-10 sm:flex-row">
        <div class="flex-1">
          <p class="section-title">Bonjour, je suis</p>
          <h1 class="mt-3 text-4xl font-bold leading-tight text-white sm:text-5xl">
            Matane Mansour
          </h1>
          <p class="mt-2 text-lg font-semibold text-accent sm:text-xl">
            Ingénieur Systèmes, Réseaux &amp; Cybersécurité
          </p>
          <p class="mt-4 max-w-xl text-base text-slate-400 sm:text-lg">
            Je construis des infrastructures fiables et sécurisées, des
            pipelines DevSecOps et des outils IA agentique de bout en bout.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#projects" class="btn-primary">Voir mes projets</a>
            <a href="#contact" class="btn-outline">Me contacter</a>
          </div>
          {cvs.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-4">
              {cvs.map((cv) => (
                <a href={`/dl/cv/${cv.slug}`} download class="font-mono text-sm text-accent hover:underline">
                  &darr; {cv.label}
                </a>
              ))}
            </div>
          )}
        </div>

        <div class="relative shrink-0">
          <div
            class="pointer-events-none absolute inset-0 -z-10 rounded-full bg-[radial-gradient(ellipse,rgba(34,211,238,0.25)_0%,transparent_70%)] blur-xl"
          >
          </div>
          <img
            src={photoPath}
            alt="Portrait de Matane Mansour"
            width="180"
            height="180"
            class="anim-float h-36 w-36 rounded-full border-2 border-accent/40 object-cover shadow-[0_0_40px_-10px_rgba(34,211,238,0.4)] sm:h-48 sm:w-48"
          />
        </div>
      </div>

      {/* Bande outils */}
      <div class="mt-10 border-t border-white/10 pt-6">
        <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-slate-500">
          Outils du quotidien
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          {tools.map((tool) => (
            <div class="flex items-center gap-2 opacity-80 transition-opacity hover:opacity-100">
              {tool.icon ? (
                <Icon name={tool.icon} class="h-4 w-4 text-accent2" />
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-accent2" aria-hidden="true">
                  <polyline points="4 6 9 12 4 18" />
                  <line x1="12" y1="18" x2="20" y2="18" />
                </svg>
              )}
              <span class="font-mono text-xs font-semibold text-slate-300">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
