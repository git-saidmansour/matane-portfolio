---
const skillGroups = [
  {
    title: 'Systèmes & Réseaux',
    skills: ['Linux', 'Windows Server', 'TCP/IP', 'Cisco (routeurs, switches, VLAN)', 'DNS / DHCP / LDAP / VPN', 'pfSense'],
  },
  {
    title: 'Cybersécurité',
    skills: ['ISO 27001 · RGPD · ANSSI', 'Trivy · DevSecOps', 'IDS/IPS (Suricata)', 'Burp Suite · Kali', 'Bug bounty (YesWeHack)'],
  },
  {
    title: 'Data & IA',
    skills: ['Python · Pandas · PySpark', 'Scikit-learn · MLflow', 'LangChain · RAG · ChromaDB', 'Power BI · Streamlit · Dataiku', 'SQL'],
  },
  {
    title: 'DevOps & Cloud',
    skills: ['Docker · GitHub Actions · CI/CD', 'Nginx · Bash', 'Azure · AWS', 'Zabbix · Wireshark · Nmap'],
  },
];
---

<section id="skills" class="section scroll-mt-24">
  <p class="section-title">Compétences</p>
  <h2 class="heading">Ma boîte à outils</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {skillGroups.map((group) => (
      <div class="card">
        <h3 class="font-mono text-sm uppercase tracking-wide text-accent2">
          {group.title}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-300">
          {group.skills.map((skill) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
