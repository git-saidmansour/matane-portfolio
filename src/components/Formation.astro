---
interface FormationEntry {
  school: string;
  period: string;
  degree: string;
  detail?: string;
}

const formations: FormationEntry[] = [
  {
    school: 'IPSSI SQY, Montigny-le-Bretonneux',
    period: '2026 – 2028',
    degree: 'Mastère Cybersécurité & Cloud (Alternance)',
  },
  {
    school: 'Université Paris 1 Panthéon-Sorbonne, Paris',
    period: '2025 – 2026',
    degree: 'DU Data Analytics',
  },
  {
    school: 'ENSP Douala — Polytech',
    period: '2024 – 2025',
    degree: 'Master 1 Cybersécurité & Cyberdéfense',
  },
  {
    school: 'IUT de Douala, Douala',
    period: '2023 – 2024',
    degree: 'Licence Administration Système & Réseaux',
  },
];
---

<section id="formation" class="section scroll-mt-24">
  <div class="section-head">
    <p class="section-title-pill">Formation</p>
    <h2 class="heading">Parcours académique</h2>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {formations.map((f) => (
      <div class="card">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-semibold text-white">{f.school}</h3>
          <span class="shrink-0 font-mono text-xs text-slate-500">{f.period}</span>
        </div>
        <p class="mt-1 text-sm text-accent2">{f.degree}</p>
        {f.detail && <p class="mt-1 text-xs text-slate-500">{f.detail}</p>}
      </div>
    ))}
  </div>
</section>
