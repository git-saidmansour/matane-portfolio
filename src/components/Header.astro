---
const links = [
  { href: '#about', label: 'À propos' },
  { href: '#projects', label: 'Projets' },
  { href: '#skills', label: 'Compétences' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 sm:px-8">
    <a href="#" class="font-mono text-sm font-semibold text-white">
      matane<span class="text-accent">@</span>portfolio<span class="text-accent">:~$</span>
    </a>
    <ul class="hidden gap-8 sm:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-mono text-sm text-slate-300 transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="btn-primary hidden text-sm sm:inline-flex">
      Me contacter
    </a>
  </nav>
</header>
