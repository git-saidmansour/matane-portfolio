---
const links = [
  { href: '#about', label: 'À propos' },
  { href: '#experience', label: 'Expériences' },
  { href: '#formation', label: 'Formation' },
  { href: '#projects', label: 'Projets' },
  { href: '#skills', label: 'Compétences' },
  { href: '#practice', label: 'Pratique' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-8">
    <a href="#" class="shrink-0 font-mono text-sm font-semibold text-white">
      matane<span class="text-accent">@</span>portfolio<span class="text-accent">:~$</span>
    </a>
    <ul class="hidden gap-5 lg:flex xl:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="whitespace-nowrap font-mono text-sm text-slate-300 transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="btn-primary hidden shrink-0 text-sm lg:inline-flex">
      Me contacter
    </a>
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
      class="flex h-9 w-9 flex-col items-center justify-center gap-1.5 lg:hidden"
    >
      <span class="h-0.5 w-5 rounded-full bg-slate-200 transition-transform"></span>
      <span class="h-0.5 w-5 rounded-full bg-slate-200 transition-opacity"></span>
      <span class="h-0.5 w-5 rounded-full bg-slate-200 transition-transform"></span>
    </button>
  </nav>

  <ul
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-white/5 bg-bg/95 px-6 pb-4 pt-2 backdrop-blur lg:hidden"
  >
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="block rounded-md px-3 py-2.5 font-mono text-sm text-slate-300 transition-colors hover:bg-white/5 hover:text-accent"
        >
          {link.label}
        </a>
      </li>
    ))}
    <li class="pt-2">
      <a href="#contact" class="btn-primary w-full justify-center text-sm">
        Me contacter
      </a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const closeMenu = () => {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
