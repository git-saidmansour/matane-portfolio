---
interface ExperienceEntry {
  title: string;
  company: string;
  period: string;
  location: string;
  bullets: string[];
}

const experiences: ExperienceEntry[] = [
  {
    title: 'Stagiaire Data Analyst',
    company: 'ManoMano',
    period: 'Fév. 2026 – Juin 2026 · 5 mois',
    location: 'Paris',
    bullets: [
      "Tableaux de bord Power BI, Tableau et Looker — KPIs e-commerce (taux de conversion, panier moyen, taux de retour)",
      "Extraction et nettoyage de données SQL, analyses comportementales des acheteurs",
      "Modèles de recommandation produits et de segmentation clients (profils, fréquence d'achat)",
    ],
  },
  {
    title: 'Stagiaire DevSecOps & Sécurité des Systèmes',
    company: 'L.SAHA Technologies Inc.',
    period: 'Sept. 2024 – Sept. 2025 · 12 mois',
    location: 'Remote',
    bullets: [
      'Scans automatisés Trivy en CI/CD sur 5+ services Docker : triage et remédiation',
      'Durcissement de serveurs Linux (SSH, Nginx, SSL/TLS), pipelines automatisés',
      'Dashboards et KPIs opérationnels, déploiement Azure',
    ],
  },
  {
    title: 'Stagiaire IT — Systèmes & Réseaux',
    company: 'GLOTELHO SARL',
    period: 'Mai 2023 – Août 2024 · 15 mois',
    location: 'Douala',
    bullets: [
      'Administration de 20+ équipements Cisco (routeurs, switches, VLANs)',
      'Configuration TCP/IP, DNS, DHCP, VPN — supervision Zabbix (SNMP, alertes temps réel)',
    ],
  },
  {
    title: 'Stagiaire Data Analyst — Performance Réseau Électrique',
    company: "ENEO (Distribution d'Électricité)",
    period: 'Jan. 2023 – Juil. 2023 · 7 mois',
    location: 'Douala',
    bullets: [
      'Collecte et nettoyage des relevés de compteurs terrain, intégration en base de données',
      'Rapports hebdomadaires sur les consommations et impayés clients par quartier',
      'Tableau de bord Power BI pour le suivi de la performance par zone',
    ],
  },
];
---

<section id="experience" class="section scroll-mt-24">
  <p class="section-title">Parcours</p>
  <h2 class="heading">Expériences professionnelles</h2>

  <div class="mt-10 space-y-8 border-l border-white/10 pl-8">
    {experiences.map((exp, i) => (
      <div class="relative">
        <span
          class={`absolute -left-8 top-1.5 h-2.5 w-2.5 -translate-x-1/2 rounded-full ${i === 0 ? 'bg-accent' : 'bg-slate-600'}`}
        />
        <div class="card">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-semibold text-white">{exp.title}</h3>
            <span class="shrink-0 font-mono text-xs text-slate-500">{exp.period}</span>
          </div>
          <p class="mt-1 text-sm text-accent">{exp.company} — {exp.location}</p>
          <ul class="mt-3 space-y-1.5 text-sm text-slate-400">
            {exp.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="text-accent">•</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
